{
  // PAIEP workspace settings (generated by templates/workspace, M7 — regenerate, don't hand-edit).
  // Rule: exactly ONE inline completion provider per workspace (Phase 09 §4.2).
  // inline_provider = {{ cookiecutter.inline_provider }} · copilot = {{ cookiecutter.copilot }}
  "continue.enableTabAutocomplete": {{ "true" if cookiecutter.inline_provider == "continue" else "false" }},
  "continue.telemetryEnabled": false,
{%- if cookiecutter.copilot == "disabled" %}
  // Sensitive workspace: hide/disable Copilot chat + inline suggestions; PAIEP (local) only.
  "chat.disableAIFeatures": true,
  "github.copilot.enable": { "*": false },
{%- else %}
  "github.copilot.enable": { "*": {{ "true" if cookiecutter.inline_provider == "copilot" else "false" }} },
{%- endif %}
  "files.exclude": { "**/__pycache__": true },
  "editor.formatOnSave": true
}
