{%- set cli = cookiecutter.compose_cli.split(' ') -%}
{
  // PAIEP MCP servers for VS Code agent mode (generated by templates/workspace, M7).
  // PRIVACY: tools listed here are callable by GitHub Copilot, whose model runs in the
  // cloud — results of rag/memory/fs calls leave this machine. Generated only because
  // copilot_mcp=yes. Remove this file for private repos.
  "servers": {
    "paiep-local": {
      "type": "stdio",
      "command": "{{ cli[0] }}",
      "args": [{% for a in cli[1:] %}"{{ a }}", {% endfor %}"-f", "__PAIEP_HOME__/docker/docker-compose.yml", "--profile", "mcp",
               "run", "--rm", "-T", "mcp-local", "fs", "git"],
      "env": { "PAIEP_WORKSPACE": "${workspaceFolder}", "PAIEP_SCOPE": "{{ cookiecutter.memory_scope }}" }
    },
    "paiep": {
      "type": "stdio",
      "command": "{{ cli[0] }}",
      "args": [{% for a in cli[1:] %}"{{ a }}", {% endfor %}"-f", "__PAIEP_HOME__/docker/docker-compose.yml", "--profile", "mcp",
               "run", "--rm", "-T", "mcp", "rag", "memory", "paiep-tools"],
      "env": { "PAIEP_WORKSPACE": "${workspaceFolder}", "PAIEP_SCOPE": "{{ cookiecutter.memory_scope }}" }
    }
  }
}
