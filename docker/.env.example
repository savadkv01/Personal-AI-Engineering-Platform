# PAIEP environment template (M0).
# Copy to `docker/.env` and adjust. The real `.env` is git-ignored (NFR-022).
# Only NON-SECRET defaults belong in this example — never commit real secrets.

# --- Project / profile -----------------------------------------------------
COMPOSE_PROJECT_NAME=paiep
# Active hardware/runtime profile: cpu (A/A+) | gpu (B/C) | server (D)
PAIEP_PROFILE=cpu

# --- Networking (ADR 0005 / 0006: loopback only) ---------------------------
# Host interface published services bind to. Keep 127.0.0.1 — never 0.0.0.0.
BIND_HOST=127.0.0.1

# --- M0 health probe (profile: core) ---------------------------------------
PING_HOST_PORT=8080

# --- M1 LLM runtime + gateway (profiles: inference | gateway | spike) -------
# Host ports are loopback-bound (BIND_HOST). Keep the gateway as the only
# intended public seam (ADR 0006); Ollama is published only for M1 validation.
GATEWAY_HOST_PORT=8081        # OpenAI-compatible gateway (nginx seam)
OLLAMA_HOST_PORT=11434        # Ollama LLM runtime (validation convenience)

# --- M2 vector DB (profiles: vectordb | spike) -----------------------------
# Qdrant is the shared vector store for RAG (M3/M4) + semantic memory (M5).
# Backend-private for consumers; ports published on loopback for bootstrap.
QDRANT_HOST_PORT=6333         # Qdrant REST API (bootstrap/inspection)
QDRANT_GRPC_HOST_PORT=6334    # Qdrant gRPC API (high-throughput clients)
QDRANT_LOG_LEVEL=INFO         # Qdrant log verbosity (TRACE|DEBUG|INFO|WARN)

# Bearer token the gateway requires on /v1/* (auth stub, ADR 0006).
# This example value is a NON-SECRET placeholder — set a real token in .env.
GATEWAY_TOKEN=paiep-local-dev-token
# Max concurrent in-flight requests the gateway admits (concurrency stub).
GATEWAY_MAX_CONCURRENCY=4

# Default models (ADR 0004). Model-agnostic: swap here, nothing hard-codes them.
CHAT_MODEL=qwen2.5-coder:7b   # 7B Q4_K_M chat/coding default (A+ machine)
EMBED_MODEL=nomic-embed-text  # embeddings default
# How long Ollama keeps a model resident after use (avoids cold reloads).
OLLAMA_KEEP_ALIVE=30m
# Default context window (tokens) for requests that cannot set num_ctx — the
# OpenAI-compatible gateway used by agents (M6). Keep equal to rag.yaml num_ctx.
OLLAMA_CONTEXT_LENGTH=8192
# Inference slots. 1 on CPU-only machines (A/A+): no throughput loss, less RAM, and
# sequential agent calls reuse the cached prompt prefix. Raise on GPU profiles (B-D).
OLLAMA_NUM_PARALLEL=1

# Pinned image tags (offline-first; validated in M1). See ADR 0004 / 0007.
OLLAMA_IMAGE=ollama/ollama:0.6.2
GATEWAY_IMAGE=nginx:1.27-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.12.6
POSTGRES_IMAGE=postgres:16.14-alpine

# --- M5 memory (profiles: memory | rag) ------------------------------------
# Postgres = canonical memory + session state; loopback-published for the host
# CLI / inspection only. Placeholder password — set a real one in .env BEFORE
# the first start (it is baked into the paiep_db volume at init).
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=change-me-local-only
# Memory config: memory.yaml (A+: Postgres + Qdrant) | memory.profile-a.yaml (SQLite).
MEMORY_CONFIG=/app/config/memory.yaml

# --- M7 VS Code integration / MCP servers (profile: mcp) --------------------
# Line endings of the mounted workspace for git inside agents/MCP containers.
# Windows checkouts (Git for Windows default core.autocrlf=true): set true, or
# `git status` in the container reports every CRLF file as modified. Linux/WSL: false.
PAIEP_GIT_AUTOCRLF=false
# PAIEP_WORKSPACE / PAIEP_SCOPE are set per editor workspace by the client MCP
# config (templates/workspace), not here. Defaults: this repo, scope global.

# --- M8 optional local UI ---------------------------------------------------
OPENWEBUI_HOST_PORT=8082
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.4
# Generate each value independently and keep it stable across restarts:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# These are placeholders only; replace them in docker/.env before enabling `ui`.
WEBUI_SECRET_KEY=replace-with-a-random-persistent-secret
MCP_UI_API_KEY=replace-with-a-different-random-secret

# --- Reserved endpoints for later milestones --------------------------------
# LANGFUSE_HOST_PORT=3000     # M9 observability
